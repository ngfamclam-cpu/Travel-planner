// Rave Run data model. Section numbers refer to the build spec.
// Dates that are calendar days (event days, trip days) use @db.Date so they never shift with time zones.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EventStatus {
  announced
  on_sale
  sold_out
  cancelled
  past
}

enum TripStatus {
  considering
  planned
  booked
  done
}

enum LineItemKind {
  flight
  hotel
  ticket
  ground
  food
  other
}

model Event {
  id                 String        @id @default(cuid())
  name               String
  brand              String?
  city               String
  country            String        @default("US")
  region             String        @default("US") // US | Asia
  venue              String?
  lat                Float?
  lng                Float?
  startDate          DateTime      @map("start_date") @db.Date
  endDate            DateTime      @map("end_date") @db.Date
  datesTentative     Boolean       @default(false) @map("dates_tentative")
  genres             String[]
  lineupHighlights   String[]      @map("lineup_highlights")
  airports           String[] // destination airports to search, e.g. {MIA,FLL}
  drivableFromBoston Boolean       @default(false) @map("drivable_from_boston")
  officialUrl        String?       @map("official_url")
  // Images pulled from the event's own site (og:image / icon), stored in `media`.
  heroMediaId        String?       @map("hero_media_id")
  iconMediaId        String?       @map("icon_media_id")
  imagesCheckedAt    DateTime?     @map("images_checked_at")
  // Edmtrain's terms: show their event link unmodified wherever their data appears.
  edmtrainUrl        String?       @map("edmtrain_url")
  // {"edmtrain": "123", "ticketmaster": "G5v..."}: ids from discovery sources, for de-duplication.
  externalIds        Json?         @map("external_ids")
  ticketUrl          String?       @map("ticket_url")
  notes              String?
  source             String        @default("manual")
  status             EventStatus   @default(announced)
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")
  ticketTiers        TicketTier[]
  trips              Trip[]
  // Ticket tracker: alert when the cheapest all-in price anywhere is at or under this.
  ticketTarget       Decimal?      @map("ticket_target") @db.Decimal(10, 2)
  /**
   * Which ticket to compare, e.g. "2-day GA". Free text, shown on the tracker.
   */
  ticketTierHint     String?       @map("ticket_tier_hint")
  ticketWatches      TicketWatch[]
  ticketPrices       TicketPrice[]

  @@unique([name, startDate])
  @@map("events")
}

model TicketTier {
  id           String   @id @default(cuid())
  eventId      String   @map("event_id")
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name         String // GA / GA+ / VIP
  tierLabel    String?  @map("tier_label") // "Tier 2", "Last tier"
  priceAllIn   Decimal? @map("price_all_in") @db.Decimal(10, 2)
  feesIncluded Boolean  @default(true) @map("fees_included")
  isResale     Boolean  @default(false) @map("is_resale")
  onSale       Boolean  @default(false) @map("on_sale")
  soldOut      Boolean  @default(false) @map("sold_out")
  observedAt   DateTime @default(now()) @map("observed_at")
  source       String
  sourceUrl    String?  @map("source_url")

  @@index([eventId])
  @@map("ticket_tiers")
}

model Trip {
  id           String        @id @default(cuid())
  name         String
  eventId      String?       @map("event_id")
  event        Event?        @relation(fields: [eventId], references: [id], onDelete: SetNull)
  status       TripStatus    @default(considering)
  slot         String? // compare group, e.g. "NYE 2026" or "Asia spring 2027"
  color        String        @default("#a855f7") // wristband stripe
  arriveDate   DateTime      @map("arrive_date") @db.Date
  departDate   DateTime      @map("depart_date") @db.Date
  flexDays     Int           @default(2) @map("flex_days")
  notes        String?
  chosenOption Json?         @map("chosen_option")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  lineItems    LineItem[]
  guide        ArrivalGuide?

  @@map("trips")
}

model LineItem {
  id              String          @id @default(cuid())
  tripId          String          @map("trip_id")
  trip            Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  kind            LineItemKind
  label           String
  // Amounts are per unit; total = amount × qty.
  estAmount       Decimal?        @map("est_amount") @db.Decimal(10, 2)
  quotedAmount    Decimal?        @map("quoted_amount") @db.Decimal(10, 2)
  bookedAmount    Decimal?        @map("booked_amount") @db.Decimal(10, 2)
  qty             Int             @default(1)
  /**
   * Off = shown on the trip but left out of every total and the date cards.
   */
  included        Boolean         @default(true)
  isEstimate      Boolean         @default(true) @map("is_estimate")
  // Provenance for the quoted amount (spec §14: every price shows source + time).
  quotedSource    String?         @map("quoted_source")
  quotedAt        DateTime?       @map("quoted_at")
  quotedUrl       String?         @map("quoted_url")
  insightLabel    String?         @map("insight_label") // Google "low" | "typical" | "high"
  // For flights: { origins: [...], destinations: [...], tripType: "round" }
  searchSpec      Json?           @map("search_spec")
  // Surge = event-window price ÷ baseline price for a normal week (spec §3).
  baselinePrice   Decimal?        @map("baseline_price") @db.Decimal(10, 2)
  baselineAt      DateTime?       @map("baseline_at")
  // Buy signal (spec §7): BUY_NOW | WAIT | WATCH | DONE, with the reason shown to the user.
  signal          String?
  signalReason    String?         @map("signal_reason")
  signalAt        DateTime?       @map("signal_at")
  signalChangedAt DateTime?       @map("signal_changed_at")
  // Hotels: what was booked ({ hotelName, stars, rating5, refundable, cancelBy, confirmation }), for rebook alerts.
  booking         Json?
  notes           String?
  sortOrder       Int             @default(0) @map("sort_order")
  cardId          String?         @map("card_id")
  card            Card?           @relation(fields: [cardId], references: [id], onDelete: SetNull)
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  snapshots       PriceSnapshot[]
  redemptions     Redemption[]
  savings         SavingsMeter[]
  alerts          Alert[]

  @@index([tripId])
  @@map("line_items")
}

model PriceSnapshot {
  id              String    @id @default(cuid())
  lineItemId      String    @map("line_item_id")
  lineItem        LineItem  @relation(fields: [lineItemId], references: [id], onDelete: Cascade)
  query           Json
  variant         String? // "base", "-1/+1", "baseline" ...
  isBaseline      Boolean   @default(false) @map("is_baseline")
  provider        String
  price           Decimal   @db.Decimal(10, 2) // fare/rate as quoted by the source
  positioningCost Decimal   @default(0) @map("positioning_cost") @db.Decimal(10, 2)
  totalPrice      Decimal   @map("total_price") @db.Decimal(10, 2) // price + positioning
  currency        String    @default("USD")
  origin          String?
  destination     String?
  outboundDate    DateTime? @map("outbound_date") @db.Date
  returnDate      DateTime? @map("return_date") @db.Date
  cabin           String?
  stops           Int?
  carrier         String?
  hotelName       String?   @map("hotel_name")
  stars           Float?
  rating          Float?
  insightLabel    String?   @map("insight_label")
  refundable      Boolean?
  /**
   * Hotel photo URL from the source (Google Hotels thumbnail).
   */
  imageUrl        String?   @map("image_url")
  rank            Int? // position within one fetch (hotels keep the top few options)
  // Hotels: which pick this row is for a date card: cheapest | value | rated | pinned | rental
  tier            String?
  bookingUrl      String?   @map("booking_url")
  fetchedAt       DateTime  @default(now()) @map("fetched_at")
  raw             Json?

  @@index([lineItemId, fetchedAt])
  @@map("price_snapshots")
}

model Card {
  id              String     @id @default(cuid())
  name            String     @unique
  network         String
  foreignFeePct   Decimal?   @map("foreign_fee_pct") @db.Decimal(4, 2) // null = unknown
  pointsCurrency  String?    @map("points_currency")
  transferEnabled Boolean?   @map("transfer_enabled") // null = unknown until settings answered
  earnRules       Json       @map("earn_rules")
  version         String? // e.g. Citi Strata vs Strata Premier
  needsSetup      Boolean    @default(false) @map("needs_setup")
  notes           String?
  lineItems       LineItem[]

  @@map("cards")
}

model PointsBalance {
  id        String   @id @default(cuid())
  currency  String   @unique // "Amex MR", "Citi TYP", "Chase UR"
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("points_balances")
}

model TransferPartner {
  id       String  @id @default(cuid())
  currency String
  partner  String
  ratio    Float   @default(1) // partner miles per point
  kind     String  @default("airline") // airline | hotel
  notes    String?

  @@unique([currency, partner])
  @@map("transfer_partners")
}

model Redemption {
  id         String   @id @default(cuid())
  lineItemId String   @map("line_item_id")
  lineItem   LineItem @relation(fields: [lineItemId], references: [id], onDelete: Cascade)
  points     Int
  taxesFees  Decimal  @map("taxes_fees") @db.Decimal(10, 2)
  cashPrice  Decimal  @map("cash_price") @db.Decimal(10, 2)
  cpp        Decimal  @db.Decimal(6, 2)
  verdict    String
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("redemptions")
}

model Brief {
  id            String   @id @default(cuid())
  date          DateTime @unique @db.Date
  html          String
  text          String
  payload       Json?
  summary       String?
  /**
   * "claude" or "template" (Claude not configured, refused, or used a number not in the payload).
   */
  summarySource String?  @map("summary_source")
  sentPush      Boolean  @default(false) @map("sent_push")
  sentEmail     Boolean  @default(false) @map("sent_email")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("briefs")
}

model Setting {
  key   String @id
  value Json

  @@map("settings")
}

model SavingsMeter {
  id            String   @id @default(cuid())
  date          DateTime @db.Date
  lineItemId    String   @map("line_item_id")
  lineItem      LineItem @relation(fields: [lineItemId], references: [id], onDelete: Cascade)
  freeBestPrice Decimal? @map("free_best_price") @db.Decimal(10, 2)
  paidBestPrice Decimal? @map("paid_best_price") @db.Decimal(10, 2)

  @@map("savings_meter")
}

// One row per provider call batch, so the UI/brief can say "couldn't check X today".
model ProviderRun {
  id        String   @id @default(cuid())
  provider  String
  kind      String // flight | hotel | event | award
  ok        Boolean
  queries   Int      @default(0)
  results   Int      @default(0)
  error     String?
  startedAt DateTime @default(now()) @map("started_at")

  @@index([provider, startedAt])
  @@map("provider_runs")
}

// 6-hour cache of identical provider queries (spec §5).
model QueryCache {
  key       String   @id
  provider  String
  response  Json
  fetchedAt DateTime @default(now()) @map("fetched_at")

  @@map("query_cache")
}

// Things the user should act on: rebook alerts now, buy signals and tier deadlines later.
model Alert {
  id          String    @id @default(cuid())
  lineItemId  String?   @map("line_item_id")
  lineItem    LineItem? @relation(fields: [lineItemId], references: [id], onDelete: Cascade)
  tripId      String?   @map("trip_id")
  kind        String // rebook | buy_now | deadline ...
  title       String
  body        String
  amount      Decimal?  @db.Decimal(10, 2) // savings, when relevant
  url         String?
  dedupeKey   String    @unique @map("dedupe_key")
  createdAt   DateTime  @default(now()) @map("created_at")
  dismissedAt DateTime? @map("dismissed_at")

  @@index([dismissedAt, createdAt])
  @@map("alerts")
}

// Ticket tracker: one row per event × platform (Ticketmaster, SeatGeek, StubHub, Vivid Seats, CrowdVolt, DICE, RA, Radiate).
model TicketWatch {
  id            String        @id @default(cuid())
  eventId       String        @map("event_id")
  event         Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  platform      String
  url           String?
  externalId    String?       @map("external_id")
  enabled       Boolean       @default(true)
  // ok | needs_link | not_listed | blocked | no_price | error | manual | not_configured
  status        String        @default("needs_link")
  lastError     String?       @map("last_error")
  officialState String?       @map("official_state") // onsale | offsale | soldout | presale (for on-sale alerts)
  findTried     Boolean       @default(false) @map("find_tried")
  lastCheckedAt DateTime?     @map("last_checked_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  prices        TicketPrice[]

  @@unique([eventId, platform])
  @@map("ticket_watches")
}

model TicketPrice {
  id            String      @id @default(cuid())
  watchId       String      @map("watch_id")
  watch         TicketWatch @relation(fields: [watchId], references: [id], onDelete: Cascade)
  eventId       String      @map("event_id")
  event         Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  platform      String
  listedPrice   Decimal     @map("listed_price") @db.Decimal(10, 2)
  allInPrice    Decimal     @map("all_in_price") @db.Decimal(10, 2)
  feesIncluded  Boolean     @map("fees_included")
  feesEstimated Boolean     @map("fees_estimated")
  highestBid    Decimal?    @map("highest_bid") @db.Decimal(10, 2)
  tierLabel     String?     @map("tier_label")
  source        String // api | page | manual
  risky         Boolean     @default(false) // Radiate: shown, never counted
  url           String?
  note          String?
  observedAt    DateTime    @default(now()) @map("observed_at")
  raw           Json?

  @@index([eventId, observedAt])
  @@map("ticket_prices")
}

// Web push endpoints for the daily brief (one per device/browser).
model PushSubscription {
  id        String    @id @default(cuid())
  endpoint  String    @unique
  keys      Json // { p256dh, auth }
  userAgent String?   @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at")
  lastOkAt  DateTime? @map("last_ok_at")

  @@map("push_subscriptions")
}

// Arrival guide per trip (spec §10): real places from OpenStreetMap / Google Places, refreshed weekly.
model ArrivalGuide {
  id          String    @id @default(cuid())
  tripId      String    @unique @map("trip_id")
  trip        Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  content     Json?
  places      Json?
  status      String    @default("requested") // requested | ok | error
  error       String?
  generatedAt DateTime? @map("generated_at")
  requestedAt DateTime? @map("requested_at")

  @@map("arrival_guides")
}

// Images fetched from festivals' and ticket sites' own pages, served by the app (/media/<key>)
// so they load offline and don't depend on hotlinking.
model Media {
  id          String   @id @default(cuid())
  key         String   @unique // "event-<id>-hero", "platform-ticketmaster-icon"
  sourceUrl   String   @map("source_url")
  contentType String   @map("content_type")
  data        Bytes
  fetchedAt   DateTime @default(now()) @map("fetched_at")

  @@map("media")
}

// Explore Asia: latest nonstop fare per route, trip shape and date (Google Flights' price calendar).
model AsiaFare {
  id          String    @id @default(cuid())
  kind        String // round | out | back
  origin      String // BOS | NYC
  city        String // TYO | SEL | SHA | HKG
  date        DateTime  @db.Date // departure (for "back", the flight home)
  returnDate  DateTime? @map("return_date") @db.Date
  nights      Int       @default(0)
  price       Decimal   @db.Decimal(10, 2)
  prevPrice   Decimal?  @map("prev_price") @db.Decimal(10, 2)
  lowPrice    Decimal   @map("low_price") @db.Decimal(10, 2)
  highPrice   Decimal   @map("high_price") @db.Decimal(10, 2)
  firstSeenAt DateTime  @default(now()) @map("first_seen_at")
  fetchedAt   DateTime  @map("fetched_at")

  @@unique([kind, origin, city, date, nights])
  @@index([date])
  @@map("asia_fares")
}

// When each calendar request (route × trip shape × 61-day slice) last ran.
model AsiaScan {
  key       String   @id
  fetchedAt DateTime @map("fetched_at")
  ok        Boolean
  found     Int      @default(0)
  error     String?

  @@map("asia_scans")
}
