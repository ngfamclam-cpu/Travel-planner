# Copy to .env on the server (never commit .env). See docs/API_KEYS.md for how to get each key.

# --- required ---
DOMAIN=raverun.example.com          # DNS A record → your droplet's IP; Caddy gets HTTPS automatically
POSTGRES_PASSWORD=change-me-long-random
APP_PASSWORD=change-me-long-passphrase   # the one login for the app
SESSION_SECRET=change-me-64-random-chars # openssl rand -hex 32

# --- step 3: flights (and hotels in step 4) ---
SERPAPI_KEY=
# Set to 0 if SerpApi rejects comma-separated airports; then one search runs per airport pair (uses more quota).
SERPAPI_COMBINE_AIRPORTS=1

# --- ticket tracker (official APIs; other platforms need no key) ---
TICKETMASTER_API_KEY=
SEATGEEK_CLIENT_ID=

# --- later steps (safe to leave empty for now) ---
EDMTRAIN_API_KEY=
ANTHROPIC_API_KEY=
RESEND_API_KEY=
BRIEF_EMAIL_TO=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
GOOGLE_PLACES_API_KEY=

# --- worker tuning ---
FLIGHT_CRON=10 5 * * *     # 5:10 AM America/New_York
HOTEL_CRON=40 5 * * *      # 5:40 AM America/New_York
TICKET_CRON=20 6 * * *     # 6:20 AM America/New_York
WORKER_PAUSE_MS=20000      # pause between live searches
