# Copy to .env on the server (never commit .env), or let scripts/setup-droplet.sh create it.
# Keep comments on their own lines: text after a value becomes part of the value.
# See docs/API_KEYS.md for how to get each key.

# --- required ---
# Your domain (A record → droplet IP), or <ip-with-dashes>.sslip.io for no DNS setup.
DOMAIN=raverun.example.com
POSTGRES_PASSWORD=change-me-long-random
# The one login for the app.
APP_PASSWORD=change-me-long-passphrase
# openssl rand -hex 32
SESSION_SECRET=change-me-64-random-chars

# --- flights + hotels (and finding ticket pages) ---
SERPAPI_KEY=
# Set to 0 if SerpApi rejects comma-separated airports (one search per airport pair instead).
SERPAPI_COMBINE_AIRPORTS=1

# --- ticket tracker (official APIs; other platforms need no key) ---
TICKETMASTER_API_KEY=
SEATGEEK_CLIENT_ID=

# --- later steps (safe to leave empty for now) ---
EDMTRAIN_API_KEY=
ANTHROPIC_API_KEY=
RESEND_API_KEY=
BRIEF_EMAIL_TO=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
GOOGLE_PLACES_API_KEY=

# --- worker schedule (America/New_York) and pacing ---
FLIGHT_CRON=10 5 * * *
HOTEL_CRON=40 5 * * *
TICKET_CRON=20 6 * * *
# Pause between live searches/page checks, in milliseconds.
WORKER_PAUSE_MS=20000
